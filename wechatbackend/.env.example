# Host development environment. Run Spring Boot from wechatbackend/ so this file is loaded.
DATABASE_URL=jdbc:postgresql://localhost:5432/wechat
DATABASE_USERNAME=wechat
DATABASE_PASSWORD=

JWT_SECRET=
JWT_ISSUER=wechat

EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email?token=
PASSWORD_RESET_URL=http://localhost:5173/reset-password?token=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Optional for local distributed realtime. Defaults keep local development process-local.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
REDIS_SSL_ENABLED=false
REALTIME_DISTRIBUTED_ENABLED=false
REALTIME_REDIS_CHANNEL=webchat:local:realtime
