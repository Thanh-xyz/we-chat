# Public entrypoint
HTTP_PORT=8080

# PostgreSQL. The local Compose service uses DB_*; set DATABASE_URL for managed/external PostgreSQL.
DB_NAME=wechat
DB_USERNAME=wechat
DB_PASSWORD=
DATABASE_URL=

# JWT (required; generate with: openssl rand -base64 64)
JWT_SECRET=
JWT_ISSUER=wechat

# SMTP (all required by the production profile)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Public frontend URLs used in authentication email links
EMAIL_VERIFICATION_URL=http://localhost:8080/verify-email?token=
PASSWORD_RESET_URL=http://localhost:8080/reset-password?token=

# Exact browser origins only; comma-separated when more than one is required
CORS_ALLOWED_ORIGINS=http://localhost:8080
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8080

# R5 distributed realtime bridge. Use the local redis service or a managed Redis endpoint.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
REDIS_SSL_ENABLED=false
REALTIME_DISTRIBUTED_ENABLED=true
RATE_LIMIT_DISTRIBUTED_ENABLED=true
RATE_LIMIT_AUTH_LOGIN_CAPACITY=5
RATE_LIMIT_AUTH_LOGIN_REFILL_MINUTES=1
RATE_LIMIT_AUTH_REFRESH_CAPACITY=20
RATE_LIMIT_AUTH_REFRESH_REFILL_MINUTES=1
RATE_LIMIT_AUTH_REGISTER_CAPACITY=5
RATE_LIMIT_AUTH_REGISTER_REFILL_MINUTES=1
RATE_LIMIT_AUTH_RESEND_VERIFICATION_CAPACITY=3
RATE_LIMIT_AUTH_RESEND_VERIFICATION_REFILL_MINUTES=15
RATE_LIMIT_MESSAGE_SEND_CAPACITY=60
RATE_LIMIT_MESSAGE_SEND_REFILL_MINUTES=1
RATE_LIMIT_WEBSOCKET_CONNECT_CAPACITY=20
RATE_LIMIT_WEBSOCKET_CONNECT_REFILL_MINUTES=1
RATE_LIMIT_NAMESPACE=webchat:ratelimit
RATE_LIMIT_ENVIRONMENT=compose
RATE_LIMIT_FALLBACK_CAPACITY=1
RATE_LIMIT_FALLBACK_REFILL_MINUTES=1
RATE_LIMIT_FALLBACK_MAX_ENTRIES=10000
REALTIME_REDIS_CHANNEL=webchat:local:realtime
INSTANCE_ID=
REALTIME_MAX_EVENT_BYTES=262144
REALTIME_PUBLISHER_CORE_SIZE=1
REALTIME_PUBLISHER_MAX_SIZE=2
REALTIME_PUBLISHER_QUEUE_CAPACITY=1000
REALTIME_LISTENER_CORE_SIZE=2
REALTIME_LISTENER_MAX_SIZE=4
REALTIME_LISTENER_QUEUE_CAPACITY=1000
REALTIME_DEDUP_CACHE_SIZE=10000
REALTIME_SHUTDOWN_TIMEOUT_SECONDS=10

# Tomcat RemoteIpValve regex matching only the fixed Nginx address below
TRUSTED_PROXY_CIDRS=172[.]30[.]0[.]10

# Data retention (ISO-8601 durations; retention does not change token TTL)
CLEANUP_REFRESH_TOKENS_ENABLED=true
CLEANUP_REFRESH_TOKENS_RETENTION=P30D
CLEANUP_REFRESH_TOKENS_BATCH_SIZE=500
CLEANUP_REFRESH_TOKENS_MAX_BATCHES_PER_RUN=20
CLEANUP_REFRESH_TOKENS_FIXED_DELAY=PT1H
CLEANUP_REFRESH_TOKENS_INITIAL_DELAY=PT5M

CLEANUP_PASSWORD_RESET_TOKENS_ENABLED=true
CLEANUP_PASSWORD_RESET_TOKENS_RETENTION=P1D
CLEANUP_PASSWORD_RESET_TOKENS_BATCH_SIZE=500
CLEANUP_PASSWORD_RESET_TOKENS_MAX_BATCHES_PER_RUN=20
CLEANUP_PASSWORD_RESET_TOKENS_FIXED_DELAY=PT1H
CLEANUP_PASSWORD_RESET_TOKENS_INITIAL_DELAY=PT10M

CLEANUP_EMAIL_VERIFICATION_TOKENS_ENABLED=true
CLEANUP_EMAIL_VERIFICATION_TOKENS_RETENTION=P7D
CLEANUP_EMAIL_VERIFICATION_TOKENS_BATCH_SIZE=500
CLEANUP_EMAIL_VERIFICATION_TOKENS_MAX_BATCHES_PER_RUN=20
CLEANUP_EMAIL_VERIFICATION_TOKENS_FIXED_DELAY=PT1H
CLEANUP_EMAIL_VERIFICATION_TOKENS_INITIAL_DELAY=PT15M

CLEANUP_NOTIFICATIONS_ENABLED=true
CLEANUP_NOTIFICATIONS_RETENTION=P180D
CLEANUP_NOTIFICATIONS_BATCH_SIZE=500
CLEANUP_NOTIFICATIONS_MAX_BATCHES_PER_RUN=40
CLEANUP_NOTIFICATIONS_FIXED_DELAY=P1D
CLEANUP_NOTIFICATIONS_INITIAL_DELAY=PT30M

# This is a technical default, not a compliance or legal-hold guarantee.
CLEANUP_AUDIT_LOGS_ENABLED=true
CLEANUP_AUDIT_LOGS_RETENTION=P180D
CLEANUP_AUDIT_LOGS_SECURITY_RETENTION=P365D
CLEANUP_AUDIT_LOGS_SECURITY_ACTIONS=AUTH_EMAIL_VERIFY,AUTH_LOGIN_FAILED,AUTH_LOGIN_SUCCESS,AUTH_LOGOUT,AUTH_PASSWORD_CHANGE,AUTH_REFRESH_TOKEN,MEDIA_ACCESS_DENIED,SECURITY_ACCESS_DENIED,SYSTEM_CONFIG_UPDATE,USER_BLOCKED,USER_CREATE,USER_DELETE,USER_ROLE_CHANGE,USER_STATUS_CHANGE,USER_UNBLOCKED
CLEANUP_AUDIT_LOGS_BATCH_SIZE=500
CLEANUP_AUDIT_LOGS_MAX_BATCHES_PER_RUN=100
CLEANUP_AUDIT_LOGS_FIXED_DELAY=P1D
CLEANUP_AUDIT_LOGS_INITIAL_DELAY=PT45M
